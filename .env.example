PORT=5000
NODE_ENV=development
MONGODB_URI=mongodb://localhost:27017/servease_ai
JWT_SECRET=servease_super_secret_jwt_key_2026_secure
CLIENT_URL=http://localhost:5173
OPENAI_API_KEY=your_openai_api_key_or_leave_blank_for_built_in_ai
GEMINI_API_KEY=your_gemini_api_key_or_leave_blank_for_built_in_ai

# SMS Gateway Provider Settings
# Options: development | fast2sms | twilio | msg91
# Set to 'development' for local testing without telecom carrier accounts.
SMS_PROVIDER=development

# Fast2SMS (Indian Gateway for +91 numbers)
FAST2SMS_API_KEY=your_fast2sms_api_key_here

# Twilio (Global SMS Gateway)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_e164

# MSG91 (Indian DLT Gateway)
MSG91_AUTH_KEY=your_msg91_auth_key_here
MSG91_TEMPLATE_ID=your_msg91_dlt_template_id

# OTP Limits & Expiry
OTP_EXPIRY_MINUTES=5
OTP_COOLDOWN_SECONDS=60
